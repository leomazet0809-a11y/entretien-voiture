// Règles de sécurité de Firebase Storage (à coller dans la console Firebase : Storage → Règles).
// Chaque compte ne peut lire et modifier que ses propres fichiers : users/{uid}/documents/…
// À l'envoi : PDF ou image uniquement, 25 Mo au plus (comme dans l'application).
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/{chemin=**} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.size <= 25 * 1024 * 1024
        && (request.resource.contentType == 'application/pdf'
            || request.resource.contentType.matches('image/.*'));
    }
  }
}
